{
  "name": "ctxora",
  "version": "6.5.1",
  "description": "Local-first context engine for coding agents.",
  "type": "module",
  "bin": {
    "ctxora": "bin/ctxora.mjs"
  },
  "files": [
    "bin",
    "src/**/*.py",
    "src/harness_context/artifacts",
    "src/harness_context/skills/ecc_catalog.json",
    "src/harness_context/skills/ecc",
    "!src/**/__pycache__",
    "!src/**/*.pyc",
    "!src/**/*.pyo",
    "pyproject.toml",
    "assets/ctxora-app-icon.png",
    "commands",
    "agents",
    "skills",
    "schemas/mcp-v2",
    "docs/COMMAND-SKILL-MAP.md",
    "docs/third-party/ECC-LICENSE",
    "THIRD_PARTY_NOTICES.md",
    ".claude-plugin",
    "README.md",
    "README.vi.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/npm/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ai-agents",
    "coding-agents",
    "context-engineering",
    "mcp",
    "rag",
    "codex",
    "claude-code",
    "cursor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nguyentrunghieutcu/ctxora-engine.git"
  },
  "homepage": "https://ctxora-landing.vercel.app/",
  "bugs": {
    "url": "https://github.com/nguyentrunghieutcu/ctxora-engine/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
